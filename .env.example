# Partner Central Channel Roles — local configuration
#
# Copy this file to `.env` (which is gitignored) and fill in real values.
# `bin/app.ts` loads `.env` at synth time via dotenv, so these are a
# convenience for LOCAL single-account deploys / synths.
#
# IMPORTANT — pipeline deployments do NOT read this file. The pipeline (and its
# self-mutation) reads the linked account id and management-role flag from CDK
# CONTEXT in the committed `cdk.json` (`partnerCentralLinkedAccountId`,
# `enableManagementRole`). `.env` is gitignored and never reaches CodeBuild, so
# anything set only here is invisible to the deployed pipelines. Set the real
# fleet values in `cdk.json`; use these vars only for local overrides.
#
# CDK `--context` flags override both `cdk.json` context and these values.

# 12-digit AWS account id of the Partner Central Linked (central) account.
# For pipeline deploys this MUST be set in cdk.json context instead. If unset
# in both context and env, the channel-roles stack is not instantiated.
PARTNER_CENTRAL_LINKED_ACCOUNT_ID=111122223333

# Optional. When "true", also provision the optional
# PartnerCentralChannelBillingTransferManagement role in each payer account.
# For pipeline deploys, set `enableManagementRole` in cdk.json context instead.
# Any value other than "true" is treated as false.
ENABLE_MANAGEMENT_ROLE=false
