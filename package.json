{
  "name": "sample-automations-for-billing-transfer",
  "version": "1.0.0",
  "description": "Automates AWS Billing Transfer management using CDK",
  "license": "MIT-0",
  "type": "module",
  "bin": {
    "bt": "dist/cli/bin/bt.js"
  },
  "engines": {
    "node": ">=22.12.0 <23.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --passWithNoTests",
    "test:unit": "NODE_OPTIONS=--experimental-vm-modules jest --passWithNoTests --testPathIgnorePatterns='/node_modules/' '/test/integration/' '.*-stack\\.test\\.ts$'",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:coverage": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "cdk": "cdk",
    "cdk:synth": "cdk synth",
    "cdk:deploy": "cdk deploy",
    "cdk:diff": "cdk diff",
    "cdk:destroy": "cdk destroy",
    "bt": "tsx cli/bin/bt.ts",
    "analyze-transfers": "tsx cli/bin/bt.ts transfers analyze"
  },
  "dependencies": {
    "@aws-lambda-powertools/idempotency": "^2.30.0",
    "@aws-lambda-powertools/logger": "^2.29.0",
    "@aws-lambda-powertools/metrics": "^2.29.0",
    "@aws-lambda-powertools/tracer": "^2.29.0",
    "@aws-sdk/client-billing": "^3.1058.0",
    "@aws-sdk/client-billingconductor": "^3.1058.0",
    "@aws-sdk/client-cloudformation": "^3.1058.0",
    "@aws-sdk/client-cloudwatch-logs": "^3.1058.0",
    "@aws-sdk/client-codepipeline": "^3.1058.0",
    "@aws-sdk/client-cost-and-usage-report-service": "^3.1058.0",
    "@aws-sdk/client-iam": "^3.1058.0",
    "@aws-sdk/client-lambda": "^3.1058.0",
    "@aws-sdk/client-organizations": "^3.1058.0",
    "@aws-sdk/client-partnercentral-channel": "^3.1058.0",
    "@aws-sdk/client-s3": "^3.1058.0",
    "@aws-sdk/client-sns": "^3.1058.0",
    "@aws-sdk/client-sqs": "^3.1058.0",
    "@aws-sdk/client-ssm": "^3.1058.0",
    "@aws-sdk/client-sts": "^3.1058.0",
    "@aws-sdk/client-support": "^3.1058.0",
    "@aws-sdk/credential-providers": "^3.1058.0",
    "@middy/core": "^7.6.5",
    "aws-cdk-lib": "^2.262.0",
    "commander": "^15.0.0",
    "constructs": "^10.4.3",
    "dotenv": "^17.4.2",
    "source-map-support": "^0.5.21"
  },
  "devDependencies": {
    "@aws-sdk/client-dynamodb": "^3.1058.0",
    "@aws-sdk/util-dynamodb": "^3.996.2",
    "@smithy/util-stream": "^4.6.6",
    "@types/aws-lambda": "^8.10.159",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.19.19",
    "aws-cdk": "^2.174.0",
    "aws-sdk-client-mock": "^4.1.0",
    "cdk-nag": "^2.38.2",
    "esbuild": "^0.28.1",
    "fast-check": "^4.3.0",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.6",
    "typescript": "^6.0.3"
  }
}
